{
  "name": "steam-family-library-owners-millennium",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Steam 家庭库透视的 Millennium 插件形态",
  "scripts": {
    "build": "node -e \"require('node:fs').mkdirSync('../build-local', { recursive: true })\" && starlight pack -o ../build-local",
    "deploy": "starlight pack",
    "watch": "starlight watch",
    "lsp": "starlight lsp"
  },
  "devDependencies": {
    "@steambrew/starlight": "^1.1.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "typescript": "^5.6.0"
  }
}
